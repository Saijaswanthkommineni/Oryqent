# Copy to .env and replace every placeholder. Never commit .env.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=oryqent
POSTGRES_USER=oryqent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_ENGINE=postgresql

REDIS_URL=redis://redis:6379/1
CACHE_KEY_PREFIX=oryqent

# Optional tuning
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REFRESH_RATE=30/min
THROTTLE_PASSWORD_CHANGE_RATE=5/min
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
# Set to the trusted reverse-proxy IP/CIDR outside the local Compose profile.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
